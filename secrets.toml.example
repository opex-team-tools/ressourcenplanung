# Streamlit Cloud: Inhalt ins Feld "Secrets" einfügen. Lokal: als .streamlit/secrets.toml speichern.
# Die beiden Zeilen ohne [Abschnitt] müssen GANZ OBEN stehen.

# Supabase > Connect > "Session pooler" (Port 5432). Sonderzeichen im Passwort codieren (& = %26, ! = %21)
DATABASE_URL = "postgresql://postgres.PROJEKT-ID:PASSWORT@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
# true = beim allerersten Start fiktive Demo-Projekte anlegen, false = leer starten
DEMO_DATEN = "true"

[auth]
# Ein gemeinsames Passwort für alle; Login = Kürzel aus der Teamliste der App
team_passwort = "HIER-PASSWORT"
# Nur diese Kürzel dürfen Mitarbeiter anlegen und Daten zurücksetzen
admins = ["dka"]

[app]
# Wird nur beim allerersten Start als Team angelegt, danach in der App gepflegt
team = ["dka", "csp", "or", "fdi", "ske", "jda", "pel"]
marke = "Firmenname"
zielauslastung = 0.80
